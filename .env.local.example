# Copy this file to `.env.local` and fill in your Supabase project values.
# Find these in your Supabase dashboard → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Optional: web push reminders (food expiring, warranties ending) ---
# Generate a key pair once with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
# A random string; Vercel Cron sends it as a bearer token to /api/push/send.
CRON_SECRET=any-long-random-string
# Service role key for the daily send job (KEEP SECRET — server only).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
